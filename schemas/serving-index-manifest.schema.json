{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobservatory.castalia.institute/schemas/serving-index-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "serviceVersion", "route", "index", "model", "corpus", "promotion"],
  "properties": {
    "schemaVersion": {"const": "jobservatory.serving-index-manifest.v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "serviceVersion": {"const": "jobservatory-search-api-v1"},
    "route": {"const": "/api/v1/search"},
    "index": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "documents", "indexBuildVersion"],
      "properties": {
        "path": {"const": "/api/search/index-v1.json"},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "documents": {"type": "integer", "minimum": 1},
        "indexBuildVersion": {"const": "jobservatory-serving-index-1.0.0"}
      }
    },
    "model": {"$ref": "#/$defs/model"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "promotion": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": {"status": {"const": "baseline_only"}, "reason": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "model": {
      "type": "object", "additionalProperties": false, "required": ["modelId", "algorithm", "parameters"],
      "properties": {
        "modelId": {"const": "bm25-production-baseline-1.0.0"},
        "algorithm": {"const": "Okapi BM25"},
        "parameters": {
          "type": "object", "additionalProperties": false, "required": ["k1", "b"],
          "properties": {"k1": {"type": "number", "exclusiveMinimum": 0}, "b": {"type": "number", "minimum": 0, "maximum": 1}}
        }
      }
    },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "observations", "descriptionPolicy"],
      "properties": {
        "schemaVersion": {"type": "string", "minLength": 1},
        "generatedAt": {"type": "string", "format": "date-time"},
        "observations": {"type": "integer", "minimum": 1},
        "descriptionPolicy": {"const": "metadata-and-evidence-only"}
      }
    }
  }
}
