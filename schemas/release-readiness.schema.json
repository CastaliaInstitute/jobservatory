{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobservatory.castalia.institute/schemas/release-readiness.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "status", "passed", "total", "gates", "responsibleAI"],
  "properties": {
    "schemaVersion": {"const": "jobservatory.release-readiness.v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["a_plus_ready", "blocked"]},
    "passed": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 1},
    "gates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "status", "evidence"], "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "status": {"enum": ["pass", "fail"]}, "evidence": {"type": "string"}
    }}},
    "responsibleAI": {"type": "object", "required": ["employmentDecisionUse", "candidateMatching", "protectedAttributeFeatures", "humanReviewRequired"], "properties": {
      "employmentDecisionUse": {"const": "prohibited"}, "candidateMatching": {"const": "disabled"},
      "protectedAttributeFeatures": {"const": "prohibited"}, "humanReviewRequired": {"const": true}
    }}
  }
}
