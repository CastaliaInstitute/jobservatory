{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobservatory.castalia.institute/schemas/search-response.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "success": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "query", "filters", "totalCandidates", "results", "lineage", "timing"],
      "properties": {
        "schemaVersion": {"const": "jobservatory.search-response.v1"},
        "requestId": {"type": "string", "format": "uuid"},
        "query": {"type": "string", "minLength": 2, "maxLength": 256},
        "filters": {"$ref": "#/$defs/filters"},
        "totalCandidates": {"type": "integer", "minimum": 0},
        "results": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/result"}},
        "lineage": {"$ref": "#/$defs/lineage"},
        "timing": {"$ref": "#/$defs/timing"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "error"],
      "properties": {
        "schemaVersion": {"const": "jobservatory.search-response.v1"},
        "requestId": {"type": "string", "format": "uuid"},
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["invalid_request", "method_not_allowed", "service_unavailable"]},
            "message": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "filters": {
      "type": "object", "additionalProperties": false, "required": ["domain", "seniority", "location", "minimumPay"],
      "properties": {
        "domain": {"type": ["string", "null"]},
        "seniority": {"type": ["string", "null"]},
        "location": {"type": ["string", "null"]},
        "minimumPay": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "observationId", "employer", "title", "location", "seniority", "domain", "compensation", "sourceUrl", "score", "componentScores"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "observationId": {"type": "string", "minLength": 1},
        "employer": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "seniority": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "compensation": {"oneOf": [{"type": "null"}, {"$ref": "serving-index.schema.json#/$defs/compensation"}]},
        "sourceUrl": {"type": "string", "format": "uri"},
        "score": {"type": "number", "minimum": 0},
        "componentScores": {
          "type": "object", "additionalProperties": false, "required": ["bm25"],
          "properties": {"bm25": {"type": "number", "minimum": 0}}
        }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["serviceVersion", "modelId", "indexSha256", "corpusGeneratedAt", "corpusContentSha256", "promotionStatus"],
      "properties": {
        "serviceVersion": {"const": "jobservatory-search-api-v1"},
        "modelId": {"const": "bm25-production-baseline-1.0.0"},
        "indexSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "corpusGeneratedAt": {"type": "string", "format": "date-time"},
        "corpusContentSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "promotionStatus": {"const": "baseline_only"}
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["indexLoadMs", "rankMs", "totalMs", "indexCacheHit", "resultCacheHit"],
      "properties": {
        "indexLoadMs": {"type": "number", "minimum": 0},
        "rankMs": {"type": "number", "minimum": 0},
        "totalMs": {"type": "number", "minimum": 0},
        "indexCacheHit": {"type": "boolean"},
        "resultCacheHit": {"type": "boolean"}
      }
    }
  }
}
