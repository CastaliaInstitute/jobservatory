{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobservatory.castalia.institute/schemas/observatory.schema.json",
  "title": "Jobservatory public corpus",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "scope", "methods", "coverage", "summary", "onet", "termIndex", "termTimeline", "observations"],
  "properties": {
    "schemaVersion": {"const": "0.2.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "scope": {"type": "string"},
    "methods": {
      "type": "object",
      "required": ["extraction", "ontology", "sampling", "labelReview"],
      "properties": {
        "extraction": {}, "ontology": {}, "sampling": {}, "labelReview": {}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["sourceRegistryVersion", "definition", "sourcesConfigured", "sourcesSuccessful", "sourceFailures", "atsProviders", "sectors", "assessment", "retrieval", "eligibleObservations", "publishedObservations", "publicationCap"],
      "properties": {
        "sourcesConfigured": {"type": "integer", "minimum": 1},
        "sourcesSuccessful": {"type": "integer", "minimum": 0},
        "sourceFailures": {"type": "array"},
        "eligibleObservations": {"type": "integer", "minimum": 0},
        "publishedObservations": {"type": "integer", "minimum": 0},
        "sourceRegistryVersion": {"type": "string"},
        "definition": {"type": "string"},
        "atsProviders": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "sectors": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "assessment": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "semantics", "targets", "actual", "checks", "missingRequiredSectors"],
          "properties": {
            "status": {"enum": ["expanding", "target_met"]},
            "semantics": {"type": "string", "minLength": 1},
            "targets": {"type": "object"},
            "actual": {"type": "object"},
            "checks": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "boolean"}},
            "missingRequiredSectors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "publicationCap": {"type": ["integer", "null"], "minimum": 1},
        "retrieval": {"type": "array", "items": {"type": "object", "required": ["employer", "ats", "sourceKey", "sector", "retrieved", "eligible", "status", "rightsReviewStatus", "responseHash", "feedSchemaVersion", "accessBasis", "documentationUrl", "documentationReviewedAt", "redistributionReviewStatus", "modelTrainingReviewStatus"], "properties": {
          "employer": {"type": "string"}, "ats": {"enum": ["greenhouse", "lever", "ashby", "smartrecruiters"]}, "sourceKey": {"type": "string"}, "sector": {"type": "string"},
          "retrieved": {"type": "integer", "minimum": 0}, "eligible": {"type": "integer", "minimum": 0}, "status": {"type": "string"},
          "rightsReviewStatus": {"enum": ["pending", "approved", "rejected"]}, "responseHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "feedSchemaVersion": {"type": "string"}, "accessBasis": {"type": "string", "pattern": "^official-public-"},
          "documentationUrl": {"type": "string", "format": "uri"}, "documentationReviewedAt": {"type": "string", "format": "date"},
          "redistributionReviewStatus": {"enum": ["pending", "approved", "rejected"]}, "modelTrainingReviewStatus": {"enum": ["pending", "approved", "rejected"]}
        }}}
      }
    },
    "summary": {"type": "object", "required": ["observations", "employers", "employerMix", "sourceConcentration", "entityResolution", "changes", "compensationCoverage", "domains"], "properties": {
      "observations": {}, "employers": {}, "employerMix": {}, "sourceConcentration": {},
      "entityResolution": {"type": "object", "required": ["methodVersion", "postingFamilies", "multiObservationFamilies", "exactVariantGroups", "repostCandidateGroups", "observationsInRepostCandidateGroups", "reviewStatus", "interpretation"], "properties": {
        "methodVersion": {"type": "string"}, "postingFamilies": {"type": "integer", "minimum": 1}, "multiObservationFamilies": {"type": "integer", "minimum": 0},
        "exactVariantGroups": {"type": "integer", "minimum": 1}, "repostCandidateGroups": {"type": "integer", "minimum": 0},
        "observationsInRepostCandidateGroups": {"type": "integer", "minimum": 0}, "reviewStatus": {"const": "unreviewed"}, "interpretation": {"type": "string"}
      }},
      "changes": {}, "compensationCoverage": {}, "domains": {}
    }},
    "onet": {
      "type": "object",
      "required": ["version", "license", "licenseUrl", "sourceUrl", "attribution", "skillProfiles", "profileSemantics"],
      "properties": {
        "version": {"const": "30.3"}, "license": {"const": "CC BY 4.0"}, "licenseUrl": {"type": "string", "format": "uri"},
        "sourceUrl": {"type": "string", "format": "uri"}, "attribution": {"type": "string"}, "skillProfiles": {}, "profileSemantics": {}
      }
    },
    "termIndex": {"type": "array"},
    "termTimeline": {"type": "array"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observationId", "analysisId", "sourceId", "employer", "title", "location", "sourceUrl", "retrievedAt", "contentHash", "roleRelevance", "classifications", "extraction", "entityResolution", "descriptionPolicy", "version", "firstSeen", "lastSeen"],
        "properties": {
          "observationId": {"type": "string"}, "analysisId": {"type": "string"}, "sourceId": {"type": "string"},
          "employer": {"type": "string"}, "title": {"type": "string"}, "location": {"type": "string"}, "sourceUrl": {"type": "string", "format": "uri"},
          "descriptionPolicy": {"const": "metadata-and-evidence-only"},
          "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "roleRelevance": {"type": "object", "properties": {"tier": {"enum": ["direct", "applied"]}}},
          "classifications": {"type": "object"}, "extraction": {"type": "object"},
          "entityResolution": {"type": "object", "required": ["methodVersion", "postingFamilyId", "exactVariantGroupId", "canonicalTitle", "canonicalLocation", "familyMatchConfidence", "exactVariantMatchConfidence", "reviewStatus", "semantics", "familySize", "exactVariantGroupSize", "repostCandidate", "hasLocationVariants"], "properties": {
            "methodVersion": {"type": "string"}, "postingFamilyId": {"type": "string", "pattern": "^family:[a-f0-9]{20}$"},
            "exactVariantGroupId": {"type": "string", "pattern": "^variant:[a-f0-9]{20}$"}, "canonicalTitle": {"type": "string"}, "canonicalLocation": {"type": "string"},
            "familyMatchConfidence": {"type": "number", "minimum": 0, "maximum": 1}, "exactVariantMatchConfidence": {"type": "number", "minimum": 0, "maximum": 1},
            "reviewStatus": {"const": "unreviewed"}, "semantics": {"type": "string"}, "familySize": {"type": "integer", "minimum": 1},
            "exactVariantGroupSize": {"type": "integer", "minimum": 1}, "repostCandidate": {"type": "boolean"}, "hasLocationVariants": {"type": "boolean"}
          }},
          "version": {"type": "integer", "minimum": 1},
          "retrievedAt": {"type": "string", "format": "date-time"},
          "firstSeen": {"type": "string", "format": "date-time"},
          "lastSeen": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
