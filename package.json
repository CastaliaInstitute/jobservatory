{
  "name": "jobservatory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy_schemas.mjs",
    "preview": "vite preview",
    "test": "npm run data:validate && npm run ml:evaluate && npm run data:card && npm run release:status && npm run schema:validate && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist",
    "data:collect": "python3 scripts/collect_listings.py",
    "data:onet": "uv run python scripts/build_onet_ontology.py",
    "data:validate": "python3 scripts/validate_onet_ontology.py && python3 scripts/validate_exports.py && python3 -m unittest tests/test_source_adapters.py",
    "data:card": "python3 scripts/build_data_card.py",
    "schema:validate": "node scripts/validate_json_schemas.mjs",
    "release:status": "python3 scripts/build_release_readiness.py",
    "benchmark:production": "python3 scripts/benchmark_production.py --write",
    "ml:evaluate": "python3 ml/retrieval_lab.py --write && python3 ml/classification_lab.py && python3 ml/validate_learned_artifacts.py && python3 ml/validate_hierarchical_artifacts.py",
    "ml:freeze": "uv run python ml/freeze_evaluation.py",
    "ml:freeze-classifier": "uv run python ml/freeze_classifier_dataset.py",
    "ml:learned": "uv run python ml/learned_retrieval.py --write",
    "ml:classify": "uv run python ml/hierarchical_classifier.py --write"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.1"
  },
  "type": "module"
}
